# makefile overrides
# OS:       Linux
# Compiler: ifort 
# OpenMP:   enabled
# BLAS:     mkl
#


CC=icc
CXX=icpc
FC=ifort
FFLAGS= -fPIC -O3 -march=native -funroll-loops 
FFLAGS2= -fPIC -march=native


OMPLIBS = -qopenmp 
OMPFLAGS = -qopenmp

LBLAS = -mkl

#MATLAB interface:
# latest MATLAB in the default install location; override on the command
# line if installed elsewhere, e.g. make matlab MATLAB_ROOT=/opt/MATLAB/R2025a
MATLAB_ROOT := $(shell ls -d /usr/local/MATLAB/R* | sort | tail -1)
MEX = $(MATLAB_ROOT)/bin/mex

# Link the mex against MATLAB's copy of Intel's OpenMP runtime (libiomp5),
# so that only one OpenMP runtime is loaded and MATLAB's BLAS/LAPACK (MKL)
# can see our OpenMP parallel regions.
MOMPLIBS = -L$(MATLAB_ROOT)/bin/glnxa64 -liomp5
